// Jenkinsfile – Projet Final DevOps LEGENI CONSULTING (Lots 4 & 5)
// Pipeline Multibranch CI/CD complet : Commit -> Quality -> Build -> Scan -> Staging -> Approbation -> Prod
pipeline {
    agent any

    environment {
        DOCKERHUB_ID    = 'legeni07'
        IMAGE_NAME      = "${DOCKERHUB_ID}/legeni-webapp"
        // Version dynamique lue depuis le fichier VERSION + build number
        BASE_VERSION    = readFile('VERSION').trim()
        APP_TAG         = "${BASE_VERSION}-${env.BUILD_NUMBER}"
        KUBECONFIG_CRED = 'kubeconfig'
        VAULT_PASS_CRED = 'ansible-vault-pass'
        DOCKER_CRED     = 'registry-credentials'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
        disableConcurrentBuilds()
    }

    stages {
        // =====================================================================
        // LOT 4 : INTÉGRATION CONTINUE (CI)
        // =====================================================================
        stage('Contrôles Qualité en Parallèle') {
            parallel {
                stage('Tests & Couverture (pytest + flake8)') {
                    steps {
                        sh '''
                            docker build --target test -t legeni-webapp:test .
                            # Exécution avec rapport JUnit et couverture
                            docker run --rm legeni-webapp:test pytest --junitxml=results.xml --cov=app --cov-report=xml:coverage.xml tests/
                        '''
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'results.xml'
                        }
                    }
                }

                stage('Lint Dockerfile (Hadolint)') {
                    steps {
                        sh '''
                            docker run --rm -i hadolint/hadolint hadolint - < Dockerfile || true
                        '''
                    }
                }

                stage('Syntaxe Ansible (Playbooks)') {
                    steps {
                        sh '''
                            ansible-playbook -i ansible/inventory.ini ansible/provision.yml --syntax-check
                            ansible-playbook -i ansible/inventory.ini ansible/deploy.yml --syntax-check
                        '''
                    }
                }
            }
        }

        stage('Build Image Docker') {
            steps {
                sh '''
                    docker build --build-arg APP_VERSION=${APP_TAG} -t ${IMAGE_NAME}:${APP_TAG} .
                '''
            }
        }

        stage('Scan Sécurité Trivy') {
            steps {
                sh """
                    # Scan des vulnérabilités critiques sans bloquer si non corrigeable
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image --severity CRITICAL --exit-code 0 ${IMAGE_NAME}:${APP_TAG}
                """
            }
        }

        stage('Publication Registre (Docker Hub)') {
            // Uniquement sur la branche principale
            when {
                branch 'main'
            }
            steps {
                withCredentials([usernamePassword(credentialsId: DOCKER_CRED,
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_TOKEN')]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${APP_TAG}
                    '''
                }
            }
        }

        // =====================================================================
        // LOT 5 : DÉPLOIEMENT CONTINU (CD)
        // =====================================================================
        stage('Déploiement Staging (Automatique)') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([file(credentialsId: KUBECONFIG_CRED, variable: 'KUBECONFIG_FILE'),
                                 file(credentialsId: VAULT_PASS_CRED, variable: 'VAULT_PASS_FILE')]) {
                    sh '''
                        export KUBECONFIG="${KUBECONFIG_FILE}"
                        ansible-playbook -i ansible/inventory.ini ansible/deploy.yml \
                            --vault-password-file "${VAULT_PASS_FILE}" \
                            -e target_env=staging \
                            -e build_number=${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Validation Humaine (Gate Production)') {
            when {
                branch 'main'
            }
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    input message: "Valider le déploiement de la version ${APP_TAG} en PRODUCTION ?",
                          ok: 'Déployer en Production'
                }
            }
        }

        stage('Déploiement Production (Sans coupure)') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([file(credentialsId: KUBECONFIG_CRED, variable: 'KUBECONFIG_FILE'),
                                 file(credentialsId: VAULT_PASS_CRED, variable: 'VAULT_PASS_FILE')]) {
                    sh '''
                        export KUBECONFIG="${KUBECONFIG_FILE}"
                        ansible-playbook -i ansible/inventory.ini ansible/deploy.yml \
                            --vault-password-file "${VAULT_PASS_FILE}" \
                            -e target_env=prod \
                            -e build_number=${BUILD_NUMBER}
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs deleteDirs: true, notFailBuild: true
        }
        success {
            echo "✅ Succès : Version ${APP_TAG} testée, construite et déployée !"
        }
        failure {
            echo "❌ Échec du pipeline sur le build ${BUILD_NUMBER}."
            // Ici possibilité d'ajouter une notification Slack / Discord / Email
        }
    }
}
