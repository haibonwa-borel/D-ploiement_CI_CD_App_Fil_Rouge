apiVersion: apps/v1
kind: Deployment
metadata:
  name: legeni-webapp
  namespace: {{ namespace }}
  labels:
    app: legeni-webapp
    version: "{{ app_image_tag }}"
spec:
  replicas: {{ app_replicas }}
  selector:
    matchLabels:
      app: legeni-webapp
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0       # 0 downtime
  template:
    metadata:
      labels:
        app: legeni-webapp
        version: "{{ app_image_tag }}"
    spec:
      containers:
        - name: webapp
          image: {{ docker_registry_user }}/legeni-webapp:{{ app_image_tag }}
          imagePullPolicy: Always
          ports:
            - containerPort: 5000
          env:
            - name: APP_ENV
              value: "{{ target_env }}"
            - name: APP_COLOR
              value: "{{ app_color }}"
            - name: APP_VERSION
              value: "{{ app_image_tag }}"
            - name: REDIS_HOST
              value: redis.{{ namespace }}.svc.cluster.local
            - name: REDIS_PORT
              value: "6379"
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: redis-secret
                  key: redis-password
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"
          readinessProbe:
            httpGet:
              path: /ready
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: 5000
            initialDelaySeconds: 15
            periodSeconds: 20
            failureThreshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: legeni-webapp
  namespace: {{ namespace }}
spec:
  type: NodePort
  selector:
    app: legeni-webapp
  ports:
    - port: 80
      targetPort: 5000
      nodePort: {{ app_nodeport }}

